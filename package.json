{
  "name": "pocketlan",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "pocketlan-gui"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "npm --prefix client run dev -- --host 0.0.0.0",
    "dev:server": "npm --prefix server run dev",
    "dev:gui": "npm --prefix pocketlan-gui run dev",
    "build": "npm --prefix client run build",
    "build:gui": "npm --prefix pocketlan-gui run build",
    "build:appimage": "npm --prefix pocketlan-gui run build:appimage",
    "start": "npm --prefix server start",
    "install:all": "npm install"
  }
}
